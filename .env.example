# 1. Banco de Dados PostgreSQL (Supabase)
SUPABASE_DB_URL=postgresql://usuario:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# 2. Coleta Automática via Gmail IMAP (ThoughtSpot Sync)
GMAIL_USER=seu_email@gmail.com
GMAIL_APP_PASSWORD=sua_senha_de_app_16_digitos

# 3. Administrador Inicial (Opcional para primeiro setup de usuários)
INITIAL_ADMIN_EMAIL=admin@pmirio.org.br
INITIAL_ADMIN_PASSWORD=SuaSenhaForteAqui
PASSWORD_SALT=pmi_rio_gov_dados_salt_2026
