# Exemplo de arquivo de variáveis de ambiente para conexão com o Supabase (PostgreSQL)
# Copie este arquivo para .env e preencha com as suas credenciais reais

# Opção 1: Connection String direta do Supabase
SUPABASE_DB_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres

# Opção 2: Variáveis individuais do PostgreSQL / Supabase
PGHOST=db.[SEU_PROJECT_REF].supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=sua_senha_aqui

# Opção 3: Banco SQLite Local (Fallback)
SQLITE_DB_PATH=voluntariado.db
